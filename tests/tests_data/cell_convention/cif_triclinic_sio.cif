# Synthetic triclinic Si/O cell (P -1, two general sites -> 4 atoms).
# Fixture for test_structure_readers_cell.cpp: all three cell angles differ
# from 90 deg, so every off-diagonal term of the lattice is observable.
data_SiO_triclinic
_chemical_formula_sum             'O Si'
_cell_length_a                    4.2
_cell_length_b                    5.1
_cell_length_c                    6.3
_cell_angle_alpha                 81.5
_cell_angle_beta                  96.2
_cell_angle_gamma                 103.7
_symmetry_space_group_name_H-M    'P -1'
_symmetry_Int_Tables_number       2
loop_
_symmetry_equiv_pos_as_xyz
'x,y,z'
'-x,-y,-z'
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
